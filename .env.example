# Copy to .env for local runs (never commit the real .env).
# Companies House API key: register an application at
#   https://developer.company-information.service.gov.uk/
CH_API_KEY=your_companies_house_key

# Anthropic API key: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key

# ORCID API (optional): director academic-credibility enrichment.
# Requires a free Public API client -- ORCID's search needs OAuth client
# credentials even on the free tier. Register at https://orcid.org (sign in
# -> Developer Tools), or see
# https://info.orcid.org/documentation/integration-guide/registering-a-public-api-client/
# Leave both blank to skip this enrichment entirely (degrades gracefully).
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# UKRI Gateway to Research (GtR): director funding-history enrichment.
# No API key needed at all -- GtR's API is fully open. Nothing to fill in
# here; it's on by default (SCANNER_FETCH_GTR=0 to disable).

# Company website check: guesses likely domains (name.co.uk, name.com) and
# does a plain HTTP GET. No API key needed. On by default
# (SCANNER_FETCH_WEBSITE=0 to disable).

# Repeat-founder check: follows each officer's own Companies House
# appointments link to see whether they hold/held another directorship in
# the same target sector. No separate key needed -- reuses CH_API_KEY
# above. On by default (SCANNER_FETCH_REPEAT_FOUNDER=0 to disable).

# Web-search enrichment: gated second Claude pass with the real web_search
# tool, for any brief scoring 2+. No separate key needed -- uses your
# ANTHROPIC_API_KEY above. Real cost ($0.01/search + tokens), OFF by default.
# See WEB_SEARCH_SPEC.md before enabling.
# SCANNER_FETCH_WEB_SEARCH=1

# Optional overrides
# SCANNER_SIC_CODES=72110,72190,21100
# SCANNER_LOOKBACK_DAYS=2
# SCANNER_MODEL=claude-sonnet-5
# SCANNER_ALERT_THRESHOLD=4
# SCANNER_FETCH_ORCID=1
# SCANNER_FETCH_GTR=1
# SCANNER_FETCH_WEBSITE=1
# SCANNER_WEB_SEARCH_THRESHOLD=2
# SCANNER_WEB_SEARCH_MAX_USES=4
# SCANNER_FETCH_REPEAT_FOUNDER=1
# SCANNER_REPEAT_FOUNDER_ADVISOR_THRESHOLD=4
# SCANNER_REPEAT_FOUNDER_SIC_CAP=10
